---
permalink: /index.json
---
[
{% for post in site.posts %}
  {"title": {{ post.title | default: 'Fragmento' | jsonify }},"url": {{ post.url | relative_url | jsonify }},"date": {{ post.date | date: '%Y-%m-%d' | jsonify }},"category": {{ post.categories | first | jsonify }},"excerpt": {{ post.description | default: post.excerpt | strip_html | strip_newlines | truncate: 140 | jsonify }}}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
